# ============================================================
# AutoReport 配置模板：复制为 .env 后填入真实值（.env 不入库）
# ============================================================

# ---------- LLM 提供商（可切换：qwen / deepseek / openai_compatible）----------
# 主力模型：多智能体规划、写作等重任务
# 小模型：元数据抽取、查询改写、LLM-as-judge 等轻任务（成本控制：模型分级）
LLM_PROVIDER=qwen

# 阿里云百炼（Qwen）：https://bailian.console.aliyun.com/
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MAIN_MODEL=qwen-plus
QWEN_SMALL_MODEL=qwen-turbo

# DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MAIN_MODEL=deepseek-chat
DEEPSEEK_SMALL_MODEL=deepseek-chat

# 其他 OpenAI 兼容端点（可选）
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MAIN_MODEL=
OPENAI_COMPATIBLE_SMALL_MODEL=

# ---------- 嵌入模型 ----------
# auto：有 Qwen Key 用百炼 text-embedding-v3；否则尝试本地模型（需安装 local-embedding 扩展）
# 可选值：dashscope / local
EMBEDDING_PROVIDER=auto

# ---------- LangSmith 评测与追踪（暂无 Key 可留空，自动降级本地日志）----------
# 注册：https://smith.langchain.com/  免费 Developer 计划
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autoreport-dev

# ---------- 存储 ----------
DB_PATH=data/db/autoreport.sqlite
CHROMA_DIR=data/db/chroma
CHECKPOINT_PATH=data/db/checkpoints.sqlite

# ---------- 采集 ----------
# 礼貌抓取：单源请求间隔秒数（>=3）
CRAWL_DELAY_SECONDS=3
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT_SECONDS=30
USER_AGENT=AutoReport-Research/0.1 (personal study project; contact: you@example.com)

# ---------- 检索 ----------
RETRIEVAL_TOP_K=6
RETRIEVAL_FINAL_K=8

# ---------- 多智能体 ----------
# 是否开启人工确认（规划确认 + 报告前确认）；CLI 可用 --auto 覆盖
HITL_ENABLED=true

# ---------- 联网搜索（可选，无 Key 自动跳过）----------
TAVILY_API_KEY=

# ---------- 其他 ----------
# 本地嵌入模型下载镜像（国内网络）
HF_ENDPOINT=https://hf-mirror.com
LOG_LEVEL=INFO
